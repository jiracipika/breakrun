config_version=5

[application]
config/name="BREAKRUN"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Sunbreak Riot — a combat runner interaction prototype."

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=486
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.98, 0.86, 0.67, 1)

[physics]
common/physics_ticks_per_second=60
